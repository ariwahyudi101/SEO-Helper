# Copy this file to `.env` and fill in your keys/settings.

# Primary AI provider (OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Fallback AI provider (DeepSeek)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# Local SQLite database path
SEO_AUDIT_DB_PATH=seo_audit.db

# Network timeout in seconds (crawl + AI requests)
SEO_AUDIT_TIMEOUT=15
